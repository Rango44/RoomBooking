<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#202020"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:text="Seminar Rooms"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        android:textColor="#FFFFFf"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.482"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/titleDivider"
        android:layout_width="300dp"
        android:layout_height="3dp"
        android:layout_marginTop="12dp"
        app:dividerColor="#CCCCCC"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        android:layout_width="90dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="36dp"
        android:text="←"
        android:textAllCaps="false"
        app:backgroundTint="#757575"
        app:cornerRadius="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAccount"
        android:layout_width="90dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="36dp"
        android:contextClickable="false"
        android:textAllCaps="false"
        app:backgroundTint="#757575"
        app:cornerRadius="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"

        app:icon="@drawable/baseline_person_24"
        app:iconGravity="textTop"
        app:iconSize="20dp" />

    <LinearLayout
        android:id="@+id/buttonRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="70dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack">


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSem1"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:contextClickable="false"
            android:text="Charles seminar room \n \n Occupancy: 4"
            android:textAllCaps="false"
            app:backgroundTint="#757575"
            app:cornerRadius="20dp"
            app:icon="@drawable/outline_display_group_24"
            app:iconGravity="textTop"
            app:iconSize="100dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSem2"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:contextClickable="false"
            android:text="Levinsky Seminar Room \n \n Occupancy: 8"
            app:backgroundTint="#757575"
            app:cornerRadius="20dp"
            app:icon="@drawable/outline_display_group_24"
            app:iconGravity="textTop"
            app:iconSize="100dp" />

    </LinearLayout>



    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Meeting rooms"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        android:textColor="#FFFFFf"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/buttonRow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/titleDivider2"
        android:layout_width="300dp"
        android:layout_height="3dp"
        android:layout_marginTop="12dp"
        app:dividerColor="#CCCCCC"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView2" />


    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/buttonFlow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="8dp"
        android:layout_marginHorizontal="8dp"

        app:constraint_referenced_ids="btnSem1,btnSem2,btnMeet1,btnMeet2,btnMeet3, btnMeet4, btnMeet5"
        app:flow_wrapMode="chain"
        app:flow_horizontalGap="8dp"
        app:flow_verticalGap="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleDivider2" />



        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMeet1"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:contextClickable="false"
            android:text="Rolle \n Occupancy: 4"
            android:textAllCaps="false"
            app:backgroundTint="#757575"
            app:cornerRadius="20dp"
            app:icon="@drawable/outline_diversity_3_24"
            app:iconGravity="textTop"
            app:iconSize="100dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMeet2"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:contextClickable="false"
            android:text="Babbage\n Occupancy: 2"
            app:backgroundTint="#757575"
            app:cornerRadius="20dp"
            app:icon="@drawable/outline_diversity_3_24"
            app:iconGravity="textTop"
            app:iconSize="100dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMeet3"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:contextClickable="false"
            android:text="Smeaton\n Occupancy: 6"
            android:textAllCaps="false"
            app:backgroundTint="#757575"
            app:cornerRadius="20dp"
            app:icon="@drawable/outline_diversity_3_24"
            app:iconGravity="textTop"
            app:iconSize="100dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMeet4"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:contextClickable="false"
            android:text="Library\n Occupancy: 10"
            app:backgroundTint="#757575"
            app:cornerRadius="20dp"
            app:icon="@drawable/outline_diversity_3_24"
            app:iconGravity="textTop"
            app:iconSize="100dp" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMeet5"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:contextClickable="false"
            android:text="Portland \n Occupancy: 4"
            app:backgroundTint="#757575"
            app:cornerRadius="20dp"
            app:icon="@drawable/outline_diversity_3_24"
            app:iconGravity="textTop"
            app:iconSize="100dp" />


</androidx.constraintlayout.widget.ConstraintLayout>